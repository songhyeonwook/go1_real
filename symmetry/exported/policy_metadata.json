{
  "obs_dim": 48,
  "action_dim": 12,
  "recurrent": {
    "is_recurrent": true,
    "rnn_type": "lstm",
    "rnn_num_layers": 1,
    "rnn_hidden_size": 256,
    "onnx_inputs": [
      "obs",
      "h_in",
      "c_in"
    ],
    "onnx_outputs": [
      "actions",
      "h_out",
      "c_out"
    ]
  },
  "note": "Proprioception-only (R48) LSTM student for peg-leg deployment. Input is the 48-dim actor observation (NO privileged terms, NO height_scan). The exported model is recurrent: ONNX carries (h_in,c_in)->(h_out,c_out); the JIT carries hidden/cell state internally. reference_zero_obs_action is the action from zero obs with a freshly zeroed hidden state. Output is the raw policy action before action scaling / default-joint-position offset.",
  "policy": {
    "class_name": "StudentTeacherRecurrent",
    "actor_obs_normalization": "false",
    "student_hidden_dims": [
      512,
      256,
      128
    ],
    "activation": "elu",
    "rnn_type": "lstm",
    "rnn_hidden_dim": 256,
    "rnn_num_layers": 1
  },
  "input": {
    "name": "obs",
    "obs_dim": 48,
    "layout": [
      {
        "group": "policy",
        "name": "base_lin_vel",
        "dim": 3,
        "slice": [
          0,
          3
        ],
        "func": "isaaclab.envs.mdp.observations:base_lin_vel"
      },
      {
        "group": "policy",
        "name": "base_ang_vel",
        "dim": 3,
        "slice": [
          3,
          6
        ],
        "func": "isaaclab.envs.mdp.observations:base_ang_vel"
      },
      {
        "group": "policy",
        "name": "projected_gravity",
        "dim": 3,
        "slice": [
          6,
          9
        ],
        "func": "isaaclab.envs.mdp.observations:projected_gravity"
      },
      {
        "group": "policy",
        "name": "velocity_commands",
        "dim": 3,
        "slice": [
          9,
          12
        ],
        "func": "isaaclab.envs.mdp.observations:generated_commands"
      },
      {
        "group": "policy",
        "name": "joint_pos",
        "dim": 12,
        "slice": [
          12,
          24
        ],
        "func": "isaaclab.envs.mdp.observations:joint_pos_rel"
      },
      {
        "group": "policy",
        "name": "joint_vel",
        "dim": 12,
        "slice": [
          24,
          36
        ],
        "func": "isaaclab.envs.mdp.observations:joint_vel_rel"
      },
      {
        "group": "policy",
        "name": "actions",
        "dim": 12,
        "slice": [
          36,
          48
        ],
        "func": "isaaclab.envs.mdp.observations:last_action"
      }
    ],
    "healthy_privileged_defaults": {}
  },
  "action": {
    "output_name": "actions",
    "action_dim": 12,
    "action_scale": 0.25,
    "default_joint_position_patterns": {
      ".*L_hip_joint": "0.1",
      ".*R_hip_joint": "-0.1",
      "F[L,R]_thigh_joint": "0.8",
      "R[L,R]_thigh_joint": "1.0",
      ".*_calf_joint": "-1.5"
    },
    "joint_names_from_env_yaml": [
      ".*"
    ],
    "postprocess": "target_joint_pos = default_joint_pos + action_scale * raw_policy_action",
    "preserve_order": "false",
    "use_default_offset": "true"
  },
  "run": {
    "experiment_name": "unitree_go1_rough_student",
    "run_name": "phase3_symmetry_s42",
    "checkpoint": "symmetry_student_deploy.pt (symmetry baseline student)"
  },
  "reference_zero_obs_action": [
    0.02926359325647354,
    -0.22524824738502502,
    -0.8449246883392334,
    0.816160261631012,
    -0.6087445020675659,
    -0.5678688883781433,
    0.051785022020339966,
    -0.15948504209518433,
    1.2859387397766113,
    1.6348707675933838,
    0.028183497488498688,
    0.5422669649124146
  ]
}